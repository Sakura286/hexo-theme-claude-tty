<%
  // 左栏：年 → 月的树，带文章数
  const years = [];
  site.posts.sort('-date').each(function (post) {
    const y = post.date.year();
    const m = post.date.month() + 1;
    let year = years[years.length - 1];
    if (!year || year.y !== y) years.push(year = { y: y, n: 0, months: [] });
    year.n++;
    let month = year.months[year.months.length - 1];
    if (!month || month.m !== m) year.months.push(month = { m: m, n: 0 });
    month.n++;
  });

  // 右栏：当前页的文章按年分组
  const groups = [];
  page.posts.each(function (post) {
    const y = post.date.year();
    let group = groups[groups.length - 1];
    if (!group || group.y !== y) groups.push(group = { y: y, posts: [] });
    group.posts.push(post);
  });

  let heading = __('nav.archives');
  if (page.year) heading += ' ' + page.year + (page.month ? '-' + pad2(page.month) : '');
  const archiveDir = config.archive_dir || 'archives';
%>
<div class="wrap split">
  <aside class="intro">
    <h1 class="intro-title"><%= heading %></h1>
    <p class="intro-text"><%= site.posts.length %> <%= __('list.posts') %></p>
    <ul class="years">
      <% years.forEach(function (year) { %>
      <li>
        <a href="<%- url_for(archiveDir + '/' + year.y + '/') %>"<% if (page.year === year.y && !page.month) { %> aria-current="page"<% } %>><%= year.y %> <span><%= year.n %></span></a>
        <ul class="tree-list">
          <% year.months.forEach(function (month) { %>
          <li><a href="<%- url_for(archiveDir + '/' + year.y + '/' + pad2(month.m) + '/') %>"<% if (page.year === year.y && page.month === month.m) { %> aria-current="page"<% } %>><%= pad2(month.m) %> <span><%= month.n %></span></a></li>
          <% }) %>
        </ul>
      </li>
      <% }) %>
    </ul>
  </aside>
  <section class="feed">
    <% groups.forEach(function (group) { %>
    <h2 class="group-head"><%= group.y %></h2>
    <% group.posts.forEach(function (post) { %>
      <%- partial('_partial/post-row', { post: post }) %>
    <% }) %>
    <% }) %>
    <%- partial('_partial/pager') %>
  </section>
</div>
